#!/bin/bash -e
# Make the Nextcloud site from the instance description, so the installer
# of Nextcloud never appears and nothing about this machine was decided
# when the layer was built (decision 0087, proposed).
#
# What it needs and where each value comes from:
#
#   secrets.app_password           -> APP_PASS   the administrator (asked by
#                                                bin/nextcloud.py at a console)
#   secrets.nextcloud_secret       -> KEEL_SECRET_NEXTCLOUD_SECRET (shared)
#   secrets.nextcloud_passwordsalt -> KEEL_SECRET_NEXTCLOUD_PASSWORDSALT (shared)
#   secrets.redis_password         -> KEEL_SECRET_REDIS_PASSWORD (shared)
#   secrets.redis_session_password -> KEEL_SECRET_REDIS_SESSION_PASSWORD (shared)
#   app.options.admin_user         -> APP_ADMIN_USER
#   app.options.db_name            -> APP_DB_NAME
#   app.domain                     -> APP_DOMAIN
#
# Runs at 40, after 35mysqlpass of lnmp. Every node writes the same
# keel-pair.config.php from the four shared secrets, its own config.php,
# the ACL of Redis and the session pool of PHP-FPM. A primary or a
# standalone node then makes the schema and runs the installation of
# Nextcloud. A replica writes nothing to the database: its schema and its
# accounts come with the copy of the primary.
#
# No secret is an argument of a process. The administrator's password goes
# through the environment of one occ call; the installation itself gets a
# throwaway password.
#
# The decisions live in lib/nextcloud.sh; this file is the part that
# touches the system.

INITHOOKS_DEFAULT="${INITHOOKS_DEFAULT:-/etc/default/inithooks}"
# shellcheck source=/dev/null
source "$INITHOOKS_DEFAULT"
# shellcheck source=../lib/nextcloud.sh
source "$INITHOOKS_PATH/lib/nextcloud.sh"
# console.sh is the one of inithooks
# shellcheck source=/dev/null
source "$INITHOOKS_PATH/lib/console.sh"

fatal() { echo "fatal [40nextcloud]: $*" >&2; exit 1; }

if [[ -e "$INITHOOKS_CONF" ]]; then
    # shellcheck source=/dev/null
    source "$INITHOOKS_CONF"
fi

NEXTCLOUD_REDIS_ACL="${NEXTCLOUD_REDIS_ACL:-/etc/redis/redis.conf.d/50-keel-nextcloud-acl.conf}"
NEXTCLOUD_SESSION_POOL="${NEXTCLOUD_SESSION_POOL:-/etc/php/8.4/fpm/pool.d/zz-keel-nextcloud.conf}"
NEXTCLOUD_FPM_SERVICE="${NEXTCLOUD_FPM_SERVICE:-php8.4-fpm}"
NEXTCLOUD_REDIS_SERVICE="${NEXTCLOUD_REDIS_SERVICE:-redis-server}"
NEXTCLOUD_GATE_UNIT="${NEXTCLOUD_GATE_UNIT:-keel-nextcloud-gate.timer}"
NEXTCLOUD_WATCH_UNIT="${NEXTCLOUD_WATCH_UNIT:-keel-nextcloud-gate-watch.service}"

admin_user=$(nextcloud_admin_user "${APP_ADMIN_USER-}") \
    || fatal "'${APP_ADMIN_USER-}' is not an account name this appliance will create"
db_name=$(nextcloud_db_name "${APP_DB_NAME-}") \
    || fatal "'${APP_DB_NAME-}' is not a database name this appliance will use"
domain=$(nextcloud_domain "${APP_DOMAIN-}") \
    || fatal "'${APP_DOMAIN-}' is not a domain or a URL: declare app.domain"
role=$(nextcloud_spec_role "$NEXTCLOUD_SPEC") \
    || fatal "cannot read database.server.role from $NEXTCLOUD_SPEC"

secret="${KEEL_SECRET_NEXTCLOUD_SECRET-}"
salt="${KEEL_SECRET_NEXTCLOUD_PASSWORDSALT-}"
redis_pass="${KEEL_SECRET_REDIS_PASSWORD-}"
session_pass="${KEEL_SECRET_REDIS_SESSION_PASSWORD-}"

mapfile -t missing < <(nextcloud_missing_values "$role" "${APP_PASS-}" \
    "$secret" "$salt" "$redis_pass" "$session_pass")
# defer WHY: the one line of a hook that asks nothing, through the rule of
# inithooks. console_deferred also records the hook, so that the first
# login starts keel-init, which runs it again at a console.
defer() {
    if declare -F console_deferred > /dev/null; then
        console_deferred 40nextcloud "$1"
    else
        console_skipped 40nextcloud "$1"
    fi
    exit 0
}

if [[ ${#missing[@]} -gt 0 ]]; then
    # The shared secrets are generated by keel (generate: required), so no
    # person types them; until all are there, nothing is written and the
    # site answers 503. A person types only the administrator password,
    # and only when somebody can answer the console (inithooks'
    # lib/console.sh).
    if [[ "${missing[*]}" != app_password ]] || console_unattended; then
        why="no ${missing[*]} in $INITHOOKS_CONF: Nextcloud stays not installed"
        why+=" and the site answers 503; declare them in the instance description"
        defer "$why"
    fi
    while IFS='=' read -r key value; do
        [[ "$key" == APP_PASS ]] && APP_PASS=$value
    done < <("$INITHOOKS_PATH/bin/nextcloud.py" APP_PASS)
    [[ -n "${APP_PASS-}" ]] || fatal "no password given"
fi

# write_file PATH OWNER MODE: standard input into PATH, by a temporary
# file beside it, so a reader never sees half a file
write_file() {
    local path=$1 owner=$2 mode=$3 tmp
    tmp=$(mktemp "$path.XXXXXX") || fatal "cannot write beside $path"
    chmod 0600 "$tmp"
    cat > "$tmp" || { rm -f "$tmp"; fatal "cannot write $path"; }
    chown "$owner" "$tmp" || { rm -f "$tmp"; fatal "cannot give $path to $owner"; }
    chmod "$mode" "$tmp"
    mv "$tmp" "$path" || { rm -f "$tmp"; fatal "cannot put $path in place"; }
}

occ() {
    runuser -u "$NEXTCLOUD_WEB_USER" -- php "$NEXTCLOUD_ROOT/occ" "$@"
}

# Redis and the PHP sessions, on every node: each node has its Redis, and
# only the node that takes writes serves (the gate).
nextcloud_redis_acl "$redis_pass" "$session_pass" \
    | write_file "$NEXTCLOUD_REDIS_ACL" root:redis 0640
nextcloud_session_pool "$session_pass" \
    | write_file "$NEXTCLOUD_SESSION_POOL" root:root 0600
systemctl restart "$NEXTCLOUD_REDIS_SERVICE.service" \
    || fatal "$NEXTCLOUD_REDIS_SERVICE did not start with the ACL of Nextcloud"
systemctl restart "$NEXTCLOUD_FPM_SERVICE.service" \
    || fatal "$NEXTCLOUD_FPM_SERVICE did not start with the session pool"

# The values of the pair, the same on both nodes
nextcloud_pair_config_php "$secret" "$salt" "$redis_pass" \
    | write_file "$NEXTCLOUD_PAIR_CONFIG" "root:$NEXTCLOUD_WEB_USER" 0640
php -l "$NEXTCLOUD_PAIR_CONFIG" > /dev/null \
    || fatal "the keel-pair.config.php just written is not valid PHP"

# The database. 35mysqlpass may have started it; do not assume it.
systemctl start "$NEXTCLOUD_DB_SERVICE.service"
nextcloud_wait_ready "mysqladmin ping" "$NEXTCLOUD_WAIT_TRIES" \
    || fatal "$NEXTCLOUD_DB_SERVICE did not answer after $NEXTCLOUD_WAIT_TRIES tries"
read_only=$(mysql --batch --skip-column-names --execute='SELECT @@global.read_only') \
    || fatal "cannot read @@global.read_only from $NEXTCLOUD_DB_SERVICE"

mark_ready() {
    mkdir -p "$(dirname "$NEXTCLOUD_READY")"
    : > "$NEXTCLOUD_READY" || fatal "cannot write $NEXTCLOUD_READY"
    systemctl enable --now "$NEXTCLOUD_GATE_UNIT" "$NEXTCLOUD_WATCH_UNIT" \
        || fatal "cannot start $NEXTCLOUD_GATE_UNIT and $NEXTCLOUD_WATCH_UNIT"
}

# addresses: the addresses of this node, one per line
addresses() {
    hostname -I 2> /dev/null | tr ' ' '\n'
}

# replica_config: a config.php that says "installed" at the version of the
# code, with the settings of this node, and no install and no occ run. The
# database and the data directory come from the primary.
replica_config() {
    local version node
    local -a ips
    [[ ! -e "$NEXTCLOUD_CONFIG" ]] || return 0
    version=$(nextcloud_code_version "$NEXTCLOUD_ROOT/version.php") \
        || fatal "cannot read the version of the code in $NEXTCLOUD_ROOT/version.php"
    mapfile -t ips < <(addresses)
    # the domain is checked at the top, so this cannot fail
    node=$(nextcloud_node_config_php "$domain" "${ips[@]}")
    write_file "$NEXTCLOUD_CONFIG" "$NEXTCLOUD_WEB_USER:$NEXTCLOUD_WEB_USER" 0640 <<EOF
<?php
\$CONFIG = [
  'dbtype' => 'mysql',
  'dbname' => $(nextcloud_php_quote "$db_name"),
  'dbhost' => $(nextcloud_php_quote "$NEXTCLOUD_DB_HOST"),
  'dbuser' => $(nextcloud_php_quote "$NEXTCLOUD_WEB_USER"),
  'dbpassword' => '',
  'dbtableprefix' => 'oc_',
  'mysql.utf8mb4' => true,
  'installed' => true,
  'version' => $(nextcloud_php_quote "$version"),
$node
];
EOF
    php -l "$NEXTCLOUD_CONFIG" > /dev/null || fatal "the config.php just written is not valid PHP"
}

node_config() {
    local -a ips
    mapfile -t ips < <(addresses)
    nextcloud_node_config_json "$domain" "${ips[@]}" | occ config:import > /dev/null \
        || fatal "occ config:import of the settings of this node failed"
    # The install wrote its log into the data directory before the setting
    # of the log file came; the data directory is a replicated path.
    rm -f "$NEXTCLOUD_DATA/nextcloud.log"
}

if nextcloud_is_replica "$role" "$read_only"; then
    replica_config
    mark_ready
    echo "this node is a replica (role '${role:-none}', read_only $read_only):" \
        "the site and its database come from the primary; nothing was written" \
        "to the database, and the gate keeps the site closed"
    exit 0
fi

# The schema and the socket account of the web user
mysql --batch --execute="CREATE DATABASE IF NOT EXISTS \`$db_name\` CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci" \
    || fatal "cannot create the database '$db_name'"
mysql --batch --execute="CREATE USER IF NOT EXISTS \`$NEXTCLOUD_WEB_USER\`@localhost IDENTIFIED VIA unix_socket; GRANT ALL PRIVILEGES ON \`$db_name\`.* TO \`$NEXTCLOUD_WEB_USER\`@localhost" \
    || fatal "cannot give $NEXTCLOUD_WEB_USER its socket account"

if [[ -e "$NEXTCLOUD_CONFIG" ]] && occ status --output=json 2> /dev/null | grep -q '"installed":true'; then
    echo "Nextcloud is already installed; leaving the site alone"
else
    # A throwaway password, because this one is an argument. The declared
    # one is set below, through the environment.
    occ maintenance:install --database=mysql --database-name="$db_name" \
        --database-host="$NEXTCLOUD_DB_HOST" --database-user="$NEXTCLOUD_WEB_USER" \
        --database-pass= --admin-user="$admin_user" \
        --admin-pass="$(openssl rand -hex 24)" --data-dir="$NEXTCLOUD_DATA" \
        || fatal "occ maintenance:install failed"
    echo "Nextcloud installed: database '$db_name' over the socket, administrator '$admin_user'"
fi

OC_PASS="$APP_PASS" runuser --whitelist-environment=OC_PASS -u "$NEXTCLOUD_WEB_USER" -- \
    php "$NEXTCLOUD_ROOT/occ" user:resetpassword --password-from-env "$admin_user" > /dev/null \
    || fatal "cannot set the password of '$admin_user'"
node_config
occ background:cron > /dev/null || fatal "cannot set the background jobs to cron"
mark_ready
echo "Nextcloud administrator '$admin_user' set from APP_PASS $(nextcloud_masked "$APP_PASS")"
